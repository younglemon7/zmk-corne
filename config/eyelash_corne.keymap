#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        bootloader_left {
            bindings = <&bootloader>;
            key-positions = <0 1 2>;
            layers = <3>;
        };

        bootloader_right {
            bindings = <&bootloader>;
            key-positions = <10 11 12>;
            layers = <3>;
        };

        reset_left {
            bindings = <&sys_reset>;
            key-positions = <0 13 28>;
            layers = <3>;
        };

        reset_right {
            bindings = <&sys_reset>;
            key-positions = <12 27 41>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB     &kp Q  &kp W           &kp E           &kp R               &kp T                                    &kp UP                &kp Y              &kp U                &kp I            &kp O            &kp P     &kp LEFT_BRACKET
&kp ESCAPE  &kp A  &hm LEFT_GUI S  &hm LEFT_ALT D  &hm LEFT_CONTROL F  &hm LEFT_SHIFT G               &kp LEFT  &kp ENTER  &kp RIGHT  &hm RIGHT_SHIFT H  &hm RIGHT_CONTROL J  &hm RIGHT_ALT K  &hm RIGHT_GUI L  &kp SEMI  &kp SQT
&caps_word  &kp Z  &kp X           &kp C           &kp V               &kp B             &kp SPACE              &kp DOWN              &kp N              &kp M                &kp COMMA        &kp DOT          &kp FSLH  &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT
                                   &kp LGUI        &mo 1               &lt 3 SPACE                                                    &lt 3 ENTER        &mo 2                &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp N1           &kp N2          &kp N3        &kp N4        &kp N5                                         &trans                           &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&trans  &bt BT_CLR_ALL   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                   &trans          &trans          &trans           &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans  &none            &none           &trans        &trans        &none            &kp C_MUTE                    &trans                           &none            &none            &none            &none            &kp END   &kp PG_DN
                                         &trans        &trans        &trans                                                                          &kp INS          &kp DEL          &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                            &trans                           &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &bt BT_CLR    &none         &none      &none      &none                &trans          &trans          &trans           &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &none      &trans                    &trans                           &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                             &kp RET    &trans     &trans
            >;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                  &trans                           &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans      &none      &none        &none      &none                   &trans          &trans          &trans           &none        &none      &none        &none       &kp PRINTSCREEN  &kp F12
&trans          &none       &trans     &none        &trans     &none     &kp C_MUTE                    &trans                           &trans       &trans     &none        &none       &kp SCROLLLOCK   &kp PAUSE_BREAK
                                       &trans       &trans     &trans                                                                   &trans       &trans     &trans
            >;
        };
    };
};
